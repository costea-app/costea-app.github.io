# Copia este archivo como .env y completa SOLO valores públicos.
# docker compose lee .env automáticamente para interpolar estas variables.
# Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_…)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# NUNCA pongas aquí service_role, sb_secret_… ni la contraseña de la base de datos.
